#!/usr/bin/env bash
# CentralPay Bridge management command. Installed to /usr/local/bin/centralpay.
# Never prints API keys, tokens, database passwords, callback secrets, or the
# full environment file.

set -Eeuo pipefail

INSTALL_DIR="${CENTRALPAY_INSTALL_DIR:-/opt/centralpay-bridge}"
CONFIG_DIR="${CENTRALPAY_CONFIG_DIR:-/etc/centralpay-bridge}"
# Where this very script gets installed (install.sh installs here too — kept
# in sync so update/rollback always know which file they are maintaining).
MANAGEMENT_BIN="${CENTRALPAY_MANAGEMENT_BIN:-/usr/local/bin/centralpay}"
ENV_FILE="${CONFIG_DIR}/centralpay.env"
CREDENTIALS_FILE="${CONFIG_DIR}/credentials.txt"

env_value() {
    # $1 = variable name; reads the config env file without exposing others.
    grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true
}

# CENTRALPAY_BACKUP_DIR is normally set inside centralpay.env (see
# deploy/centralpay.env.template), the same single source of truth `compose`
# already reads ADMIN_BOT_ENABLED/MONITOR_ENABLED from. It must also be
# exported into THIS process's environment: docker-compose.yml's own
# ${CENTRALPAY_BACKUP_DIR:-...} bind-mount interpolation reads the invoking
# shell's environment, not env_file:, so without this export an operator's
# customized backup path would silently fall back to the default on the
# host side while this script (via $BACKUP_DIR below) used the right one.
_configured_backup_dir=$(env_value CENTRALPAY_BACKUP_DIR)
BACKUP_DIR="${_configured_backup_dir:-${CENTRALPAY_BACKUP_DIR:-/var/backups/centralpay-bridge}}"
export CENTRALPAY_BACKUP_DIR="$BACKUP_DIR"
unset _configured_backup_dir

log()  { printf '\033[1;32m[centralpay]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[centralpay] WARNING:\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31m[centralpay] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

trap 'printf "\033[1;31m[centralpay] Command failed.\033[0m\n" >&2' ERR

usage() {
    cat <<'EOF'
Usage: centralpay COMMAND [ARGS]

Service:
  status                 Overall health and state summary
  logs [COMPONENT]       Recent + live logs (api|worker|db|caddy)
  logs-errors [COMPONENT] Warning/error events only
  restart | stop | start Service lifecycle
  version                Application and stack versions

Deployment:
  update --check         Show installed vs available version
  update                 Verify release checksum, backup, deploy, migrate, restart
  rollback               Roll application files back to the previous version
  migrate [SUB]          Run migrations (SUB: upgrade|current|history; default upgrade)
  ssl                    Re-check DNS and retry TLS certificate issuance

Manual review (host-only; never changes financial records):
  review list [--all]    Unresolved manual-review payments
  review show ORDER_ID   Full review detail
  review acknowledge ORDER_ID --note TEXT
  review resolve ORDER_ID --resolution VALUE --note TEXT
  review resend ORDER_ID --confirm-idempotent-bot --yes   (idempotent mode only)

Notification:
  notification accept ORDER_ID --note TEXT [--yes]
      Mark one already-processed, gateway-verified bot notification as
      operator-confirmed accepted without contacting the bot. For a
      payment stuck in bot_notify_pending after the operator has
      independently confirmed (with the downstream bot) that it was
      already delivered and processed. Never contacts the bot or
      CentralPay, never changes payment amounts or gateway verification,
      and permanently stops automatic retries for that one payment.

Data:
  backup                 Create a validated PostgreSQL backup now
  backups                List backups with validation state
  restore FILE [--yes]   Restore a backup (asks for confirmation)
  db-check [--repair-sequences]  Database integrity checks (read-only by default)
  db-check --details [--json]    Same report, plus a bounded, read-only drill-down
                                  into the rows behind any failed check
                                  (mutually exclusive with --repair-sequences)

Service fee (changes apply to NEW orders only; history is permanent):
  fee status             Current fee, policy ID, and next scheduled change
  fee set RATE --note TEXT          Set the fee now (e.g. RATE=10 or 7.5)
  fee schedule RATE --at ISO --note TEXT   Schedule a future fee change
  fee history            Full append-only policy history
  fee cancel POLICY_ID --note TEXT  Cancel a scheduled policy (kept in history)

Inspection:
  diagnose               Full system diagnosis (no secrets printed)
  stuck [--limit N] [--json]  Categorized view of payments needing attention
                          (need attention / waiting gateway / expired links)
  reconciliation status [--json]
                          Reconciliation runtime, effective configuration,
                          payment buckets, and queue health. Reads the
                          WORKER container's live configuration (never api,
                          which can be stale after a worker-only redeploy).
  reconcile ORDER_ID [--verify [--confirm-aged-out]] [--json]
                          Inspect one payment. Local-only by default (no
                          network call, never mutates the database).
                          --verify performs exactly one gateway query and
                          reports what settlement would conclude -- it
                          never settles and is read-only on OUR side only;
                          CentralPay's own verify-after-verify behavior is
                          NOT confirmed safe to call repeatedly (see
                          STAGING_VALIDATION.md), so --verify is disabled
                          by default (CENTRALPAY_DIAGNOSTIC_VERIFY_ENABLED).
                          Refuses (no network call) if diagnostic verify is
                          disabled, already verified, in manual_review, or
                          aged out; --confirm-aged-out overrides only the
                          last case and cannot bypass the disabled-gate
                          refusal. Reads the WORKER container's live
                          configuration (never api, which can be stale
                          after a worker-only redeploy) for
                          tier/aged-out/enabled classification.
  recover-aged-out ORDER_ID [--confirm] [--json]
                          Explicit, single-payment recovery for one
                          link_created payment the reconciliation worker
                          has excluded for aging out (link age >=
                          RECONCILIATION_MAX_AGE_SECONDS). Preview-only by
                          default (no network call, no lock, no database
                          write). --confirm locks the row, re-checks
                          eligibility under that lock, and -- only if still
                          eligible -- calls the SAME canonical
                          verify_and_settle() the callback and
                          reconciliation worker already share, exactly
                          once; it never re-enables automatic
                          reconciliation for the payment and never accepts
                          more than one ORDER_ID. Reads the WORKER
                          container's live configuration (never api) for
                          the same reason as `reconcile`/`reconciliation
                          status` above.
  payment ORDER_ID       One payment with its audit history
  recent                 Most recent payments
  retry-queue            Payments awaiting bot notification
  manual-review          Payments requiring administrator review
  credentials            Show the installation summary (root only)

Monitoring (requires MONITOR_ENABLED=true; see "Monitor service" below):
  monitor check [--json] Run every monitoring check now (public readiness,
                          database, worker heartbeats, notification/manual-
                          review backlog, reconciliation health, backup
                          freshness, disk space, DB integrity, gateway/bot
                          failure bursts) and report overall status.
  monitor incidents [--all] [--json]
                          Currently open incidents (default), or every
                          recorded incident (--all) including resolved
                          history. Read-only; never re-runs a check.

Administrator Telegram bot:
  admin-bot status       Admin bot container state and configuration state
  admin-bot logs         Admin bot logs
  admin-bot restart      Restart the admin bot service
  admin-bot enable       Validate configuration and start the admin bot
  admin-bot disable      Stop the admin bot (configuration preserved)
  admin-bot test-alert   Queue a clearly marked test message to administrators

Monitor service (dedicated process; MONITOR_ENABLED=false by default):
  monitor status         Monitor container state and configuration state
  monitor logs           Monitor logs
  monitor restart        Restart the monitor service
  monitor enable         Start the monitor service (MONITOR_ENABLED=true)
  monitor disable        Stop the monitor service (configuration preserved)
  Alerts are delivered through the existing administrator Telegram bot
  (admin-bot must also be enabled for Telegram delivery; monitor incidents
  are tracked in the database either way -- see "monitor incidents" above).

Removal:
  uninstall              Remove services (data and backups preserved by default)
EOF
}

# True iff `-h` or `--help` appears anywhere in the given arguments BEFORE a
# literal `--`. Used to short-circuit a production-mutating command straight
# to `usage`/exit 0 BEFORE any side-effecting code runs -- see the guard in
# main() below. Deliberately checked as a standalone token (never a
# substring), so a `--note`/`--resolution` VALUE would have to be the
# literal two-or-four character string "-h"/"--help" to match; that is far
# safer than silently proceeding into a real update/restore/migration/etc.
# on ambiguous input.
#
# A literal `--` (the standard end-of-options marker) stops the scan: an
# opaque, operator/bot-supplied order ID that genuinely equals "-h" or
# "--help" (the create-payment contract accepts arbitrary non-control
# strings unchanged, so this is a real, if rare, possible value) can still
# be addressed via `centralpay review show -- --help`, `notification
# accept -- -h`, etc. -- every guarded command's underlying `app.ops`
# argparse subparser already honors `--` as the standard end-of-options
# marker, so a value after `--` is passed straight through positionally.
# `-h`/`--help` tokens BEFORE a `--` are unaffected and still trigger help
# immediately, so the original incident (`update --help` running a real
# update) stays fixed exactly as before.
wants_help() {
    local a
    for a in "$@"; do
        case "$a" in
            --) return 1 ;;
            -h | --help) return 0 ;;
        esac
    done
    return 1
}

require_root() {
    [[ "$(id -u)" -eq 0 ]] || fail "This command requires root. Use: sudo centralpay $*"
}

require_install() {
    [[ -f "${INSTALL_DIR}/docker-compose.yml" ]] \
        || fail "No installation found in ${INSTALL_DIR}. Run the installer first."
}

compose() {
    # The admin-bot and monitor services each live behind their own Compose
    # profile, keyed off the single source of truth in the config env file.
    local -a profile_args=()
    if grep -qE '^ADMIN_BOT_ENABLED=true$' "$ENV_FILE" 2>/dev/null; then
        profile_args+=(--profile admin-bot)
    fi
    if grep -qE '^MONITOR_ENABLED=true$' "$ENV_FILE" 2>/dev/null; then
        profile_args+=(--profile monitor)
    fi
    docker compose --project-directory "$INSTALL_DIR" "${profile_args[@]}" "$@"
}

payment_domain() {
    env_value PUBLIC_BASE_URL | sed -E 's#^https?://##'
}

psql_count() {
    # $1 = SQL; prints a number or "n/a".
    compose exec -T db psql -U centralpay -d centralpay -tAc "$1" 2>/dev/null | tr -d '[:space:]' || echo "n/a"
}

app_version() {
    grep -E '^APP_VERSION' "${INSTALL_DIR}/app/version.py" 2>/dev/null \
        | sed -E 's/.*"(.*)".*/\1/' || echo "unknown"
}

caddy_activation_status_line() {
    # $1 = the command name to suggest in the non-root message (defaults to
    # "status"; cmd_diagnose passes "diagnose" so the suggested command
    # actually matches what the operator just ran).
    local suggested_cmd="${1:-status}"
    # Read-only: invokes render-caddy-config.sh's --check mode only, which
    # never mutates the Caddyfile, never validates against Docker, never
    # restarts anything (see that script's header for the exit-code
    # contract). This does NOT close the one-time first-upgrade bootstrap
    # gap documented in SECURITY.md -- a process still executing the OLD,
    # already-loaded `perform_update` never reaches this new code at all,
    # on this or any command. What it DOES do is turn that gap from silent
    # (persisting until an operator happens to rerun `update` or the
    # installer) into loud: the very next `status`/`diagnose` call after
    # the flawed first update already runs from the NEWLY installed
    # wrapper (sync_management_wrapper replaces it before that first
    # update's process exits), so it surfaces the drift immediately.
    local script="${INSTALL_DIR}/scripts/render-caddy-config.sh"
    [[ -f "$script" ]] || return 0
    if [[ "$(id -u)" -ne 0 ]]; then
        # CONFIG_DIR is 0700 root-owned (it holds centralpay.env, which
        # contains real secrets) and the Caddyfile/activation marker inside
        # it are 0600 -- a non-root caller cannot read either, the same
        # pre-existing limitation payment_domain() already degrades
        # gracefully around (see "(domain unknown -- configuration
        # unreadable)" above). Report that plainly, matching that existing
        # tone, rather than running --check anyway and having it report a
        # generic, alarming "could not determine" on every single healthy
        # non-root status/diagnose call.
        echo "  Caddy config: sync status requires root (rerun via: sudo centralpay ${suggested_cmd})"
        return 0
    fi
    local rc=0
    bash "$script" --check >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0) echo "  Caddy config: in sync, activation confirmed" ;;
        2) warn "Installed Caddy configuration is OUT OF SYNC with the checked-out source, or a prior change was applied but never confirmed active. Mandatory security directives (Referer/URI secret redaction, security headers, admin API disabled) may not be enforced. Close this now: sudo centralpay update (run again if this is right after a first update past a security fix), or rerun the installer: curl -fsSL https://raw.githubusercontent.com/${REPO_SLUG}/main/install.sh | sudo bash" ;;
        *) warn "Could not determine Caddy configuration sync status (render-caddy-config.sh --check exited ${rc})." ;;
    esac
}

# ---------------------------------------------------------------------------

cmd_status() {
    require_install
    local domain
    domain=$(payment_domain)
    echo "CentralPay Bridge status"
    echo "========================"
    echo
    echo "-- Containers --"
    compose ps 2>/dev/null || warn "Cannot query containers (is Docker running?)"
    echo
    echo "-- Health --"
    for svc in api worker db caddy; do
        local cid state health
        cid=$(compose ps -q "$svc" 2>/dev/null || true)
        if [[ -n "$cid" ]]; then
            state=$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || echo unknown)
            health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}}' "$cid" 2>/dev/null || echo n/a)
            printf '  %-8s state=%s health=%s\n' "$svc" "$state" "$health"
        else
            printf '  %-8s not running\n' "$svc"
        fi
    done
    echo
    echo "-- Public health --"
    if [[ -n "$domain" ]]; then
        local code
        code=$(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' "https://${domain}/health/ready" 2>/dev/null || echo "000")
        echo "  https://${domain}/health/ready -> HTTP ${code}"
        if [[ "$code" == "200" ]]; then
            echo "  TLS: active"
        else
            echo "  TLS: not confirmed (DNS pending, certificate pending, or service down)"
        fi
    else
        echo "  (domain unknown — configuration unreadable)"
    fi
    echo
    echo "-- Caddy configuration --"
    caddy_activation_status_line status
    echo
    echo "-- Queues --"
    echo "  pending notifications: $(psql_count "SELECT count(*) FROM payments WHERE status='bot_notify_pending'")"
    # Unresolved only -- a row an operator already resolved via
    # `centralpay review resolve` keeps status='manual_review' permanently
    # as history (review_resolved_at is stamped instead), so a plain
    # status count would report an ever-growing, mostly-historical number
    # here that never matches `centralpay review list` or the monitor's
    # manual_review check (see app.adminbot.queries.count_open_manual_reviews).
    echo "  unresolved manual reviews: $(psql_count "SELECT count(*) FROM payments WHERE status='manual_review' AND review_resolved_at IS NULL")"
    echo
    echo "-- Backups --"
    local last_backup
    last_backup=$(find "$BACKUP_DIR" -name '*.dump' -type f -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | head -1 | cut -d' ' -f2- || true)
    if [[ -n "$last_backup" ]]; then
        echo "  last backup: ${last_backup} ($(date -u -r "$last_backup" +%Y-%m-%dT%H:%M:%SZ))"
    else
        echo "  last backup: none found in ${BACKUP_DIR}"
    fi
    echo
    echo "-- System --"
    echo "  disk: $(df -h / | awk 'NR==2 {print $4 " free of " $2 " (" $5 " used)"}')"
    echo "  docker compose: $(docker compose version --short 2>/dev/null || echo unavailable)"
    echo "  application: $(app_version)"
}

validate_component() {
    # Allowlist (audit): log commands accept only known service names —
    # never arbitrary Compose service names or option-like values.
    case "$1" in
        api|worker|db|caddy|admin-bot|migrate) return 0 ;;
        *) fail "Unknown component: $1 (use api|worker|db|caddy|admin-bot|migrate)" ;;
    esac
}

cmd_logs() {
    require_install
    local svc="${1:-}"
    if [[ -n "$svc" ]]; then
        validate_component "$svc"
        compose logs --tail 200 -f "$svc"
    else
        compose logs --tail 100 -f
    fi
}

cmd_logs_errors() {
    require_install
    local svc="${1:-}"
    local -a target=()
    if [[ -n "$svc" ]]; then
        validate_component "$svc"
        target=("$svc")
    fi
    # Structured JSON logs carry "level"; plain logs are matched by keyword.
    compose logs --tail 1000 "${target[@]}" 2>&1 \
        | grep -Ei '"level": ?"(warning|error|critical)"|\b(error|warning|critical|fatal)\b' \
        || echo "No warning or error events in the recent logs."
}

cmd_migrate() {
    require_root migrate
    require_install
    local sub="${1:-upgrade}"
    case "$sub" in
        upgrade) compose run --rm migrate alembic upgrade head ;;
        current) compose run --rm migrate alembic current ;;
        history) compose run --rm migrate alembic history ;;
        *) fail "Unknown migrate subcommand: ${sub} (use upgrade|current|history)" ;;
    esac
}

VERSION_HISTORY_FILE="${CONFIG_DIR}/version_history"
DEPLOY_LOCK_FILE="${CONFIG_DIR}/.deploy.lock"
REPO_SLUG="Mhoseinshah1/centralpay-bridge"

acquire_deploy_lock() {
    # Serialize update/rollback so two concurrent deploys cannot interleave
    # their git checkout, version-history write, and compose build/up (which
    # would leave the worktree and version_history inconsistent). Uses a
    # dedicated lock on fd 8, distinct from the backup lock (fd 9), so the
    # nested pre-deploy backup never self-deadlocks. Non-blocking: a second
    # deploy fails fast instead of piling up behind the first. The lock
    # releases automatically when the process exits.
    exec 8>"$DEPLOY_LOCK_FILE" || fail "Cannot open deploy lock ${DEPLOY_LOCK_FILE}."
    flock -n 8 \
        || fail "Another update or rollback is already running (deploy lock held). Wait for it to finish, then retry."
}

record_version_history() {
    # $1 = new sha; $2 = explicit previous sha (optional). Keeps current and
    # previous for rollback.
    #
    # $2 exists because the very first `centralpay update` has no
    # version_history file yet: the pre-update commit must be passed in
    # explicitly by the caller, otherwise `previous` is recorded empty and
    # `centralpay rollback` fails ("No previous version recorded") for exactly
    # the first upgrade. When $2 is omitted, fall back to the file's current=
    # line (the behavior used on later updates / rollbacks).
    local new_sha="$1" previous_sha="${2:-}"
    if [[ -z "$previous_sha" && -f "$VERSION_HISTORY_FILE" ]]; then
        previous_sha=$(grep -E '^current=' "$VERSION_HISTORY_FILE" | cut -d= -f2- || true)
    fi
    umask 077
    {
        echo "current=${new_sha}"
        echo "previous=${previous_sha}"
        echo "updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$VERSION_HISTORY_FILE"
    chmod 600 "$VERSION_HISTORY_FILE"
}

is_release_tag() {
    # Strict release-tag grammar: vX.Y.Z or vX.Y.Z-rcN, nothing else.
    # Rejects v1.2.3evil, v1.2.3/other, v1.2.3-rc (no number), main, etc.
    [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?$ ]]
}

verify_manifest_and_extract_commit() {
    # $1 = SHA256SUMS path, $2 = exact runtime artifact filename,
    # $3 = downloaded artifact path, $4 = downloaded SOURCE_COMMIT path.
    #
    # Prints the 40-char lowercase-hex commit on stdout and returns 0 ONLY when
    # ALL of the following hold; otherwise prints a fixed reason to stderr,
    # nothing to stdout, and returns non-zero:
    #   * SHA256SUMS contains EXACTLY one line for the exact artifact filename
    #     and EXACTLY one line for the exact filename "SOURCE_COMMIT", each
    #     formatted precisely as `[0-9a-f]{64}  <exact filename>` (64 lowercase
    #     hex, two spaces, exact name). No wildcard is used to locate entries;
    #     "./SOURCE_COMMIT", "path/SOURCE_COMMIT", "SOURCE_COMMIT.old",
    #     similarly named artifacts, binary "*" markers, uppercase or malformed
    #     hashes, duplicates, and leading/trailing junk are all rejected.
    #   * The SOURCE_COMMIT file bytes full-match `[0-9a-f]{40}` or
    #     `[0-9a-f]{40}\n` — read as RAW BYTES, so embedded newlines, a second
    #     trailing newline, CRLF, leading/trailing spaces, tabs, NUL/control
    #     bytes, uppercase hex, and any length other than 40 or 41 bytes are
    #     rejected (no normalization of malformed input into validity).
    #   * The artifact and SOURCE_COMMIT files hash to their individually
    #     selected expected values from the manifest.
    python3 - "$1" "$2" "$3" "$4" <<'PY'
import hashlib
import re
import sys

manifest_path, artifact_name, artifact_path, source_path = sys.argv[1:5]


def die(msg):
    sys.stderr.write("SOURCE_COMMIT/manifest verification failed: " + msg + "\n")
    raise SystemExit(1)


try:
    with open(manifest_path, "rb") as fh:
        manifest = fh.read()
except OSError:
    die("cannot read SHA256SUMS")


def exact_hashes(name):
    # Whole-line match: 64 lowercase hex, exactly two spaces, exact filename.
    pattern = re.compile(rb"^([0-9a-f]{64})  " + re.escape(name.encode()) + rb"$")
    found = []
    for line in manifest.split(b"\n"):
        if line == b"":
            continue
        m = pattern.fullmatch(line)
        if m is not None:
            found.append(m.group(1).decode())
    return found


artifact_hashes = exact_hashes(artifact_name)
source_hashes = exact_hashes("SOURCE_COMMIT")
if len(artifact_hashes) != 1:
    die("expected exactly one artifact entry (%s), found %d" % (artifact_name, len(artifact_hashes)))
if len(source_hashes) != 1:
    die("expected exactly one SOURCE_COMMIT entry, found %d" % len(source_hashes))

try:
    with open(source_path, "rb") as fh:
        raw = fh.read()
except OSError:
    die("cannot read SOURCE_COMMIT")
if re.fullmatch(rb"[0-9a-f]{40}\n?", raw) is None:
    die("SOURCE_COMMIT is not exactly one 40-char lowercase hex commit (with at most one trailing newline)")
commit = raw[:40].decode()


def sha256_file(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(65536), b""):
                h.update(chunk)
    except OSError:
        die("cannot read " + path)
    return h.hexdigest()


if sha256_file(artifact_path) != artifact_hashes[0]:
    die("artifact checksum mismatch")
if sha256_file(source_path) != source_hashes[0]:
    die("SOURCE_COMMIT checksum mismatch")

sys.stdout.write(commit + "\n")
PY
}

resolve_verified_update_commit() {
    # $1 = update ref. Prints (stdout) the exact Git commit SHA to deploy and
    # returns 0; prints NOTHING to stdout and returns non-zero on any failure.
    #
    # For a release tag this BINDS the deployed commit to a separately
    # checksummed SOURCE_COMMIT release asset: the fetched tag commit must
    # equal the verified SOURCE_COMMIT, so a tag moved after the release
    # assets were produced is rejected BEFORE any checkout/build/migration/
    # restart. A checksum alone (over the discarded tarball) never proved
    # what git actually deploys.
    #
    # A non-tag ref (a branch such as main/master) fails closed by default —
    # production updates must pin a release tag. CENTRALPAY_UPDATE_ALLOW_DEV_REF=true
    # is the explicit, root-operator opt-in for a LOCAL DEVELOPMENT install to
    # deploy a branch instead; it must never be set on a production host.
    local ref="$1" tmp base artifact fetched source_commit allow_unverified=false
    grep -qE '^CENTRALPAY_UPDATE_ALLOW_UNVERIFIED=true$' "$ENV_FILE" 2>/dev/null \
        && allow_unverified=true

    git -C "$INSTALL_DIR" fetch --tags --force origin "$ref" >/dev/null 2>&1 \
        || fail "Cannot fetch ${ref} from origin."
    # ^{commit} dereferences annotated tags to the underlying commit object.
    fetched=$(git -C "$INSTALL_DIR" rev-parse --verify --quiet "FETCH_HEAD^{commit}") \
        || fail "Cannot resolve fetched ref ${ref} to a commit."

    if ! is_release_tag "$ref"; then
        local allow_dev_ref=false
        grep -qE '^CENTRALPAY_UPDATE_ALLOW_DEV_REF=true$' "$ENV_FILE" 2>/dev/null \
            && allow_dev_ref=true
        if [[ "$allow_dev_ref" != "true" ]]; then
            fail "Update ref '${ref}' is not a release tag. Production updates must pin CENTRALPAY_UPDATE_REF to a release tag (vX.Y.Z or vX.Y.Z-rcN) so the update can be checksum- and SOURCE_COMMIT-verified. To deploy a branch on a LOCAL DEVELOPMENT install only, set CENTRALPAY_UPDATE_ALLOW_DEV_REF=true in ${ENV_FILE} (never on a production host)."
        fi
        warn "Update ref '${ref}' is not a release tag (DEVELOPMENT MODE, CENTRALPAY_UPDATE_ALLOW_DEV_REF=true): NO checksum and NO SOURCE_COMMIT binding."
        printf '%s\n' "$fetched"
        return 0
    fi

    tmp=$(mktemp -d)
    base="${CENTRALPAY_RELEASE_BASE_URL:-https://github.com/${REPO_SLUG}/releases/download}/${ref}"
    artifact="centralpay-bridge-${ref#v}.tar.gz"
    log "Verifying release assets and SOURCE_COMMIT binding for ${ref}..." >&2
    if ! curl -fsSL -o "${tmp}/${artifact}" "${base}/${artifact}" \
        || ! curl -fsSL -o "${tmp}/SOURCE_COMMIT" "${base}/SOURCE_COMMIT" \
        || ! curl -fsSL -o "${tmp}/SHA256SUMS" "${base}/SHA256SUMS"; then
        rm -rf "$tmp"
        if [[ "$allow_unverified" == "true" ]]; then
            warn "Release assets not downloadable; continuing UNVERIFIED (CENTRALPAY_UPDATE_ALLOW_UNVERIFIED=true): NO checksum verification and NO SOURCE_COMMIT commit binding are performed. Deploying the fetched tag commit as-is."
            printf '%s\n' "$fetched"
            return 0
        fi
        fail "Cannot download the release assets (artifact, SOURCE_COMMIT, SHA256SUMS) for ${ref}. Publish the GitHub release first, or set CENTRALPAY_UPDATE_ALLOW_UNVERIFIED=true (not recommended)."
    fi
    # Strict manifest parsing + exact SOURCE_COMMIT byte grammar + both
    # checksums, all in one fail-closed helper (no wildcard entry matching, no
    # newline normalization). Returns the verified 40-hex commit on stdout.
    if ! source_commit=$(verify_manifest_and_extract_commit \
        "${tmp}/SHA256SUMS" "$artifact" "${tmp}/${artifact}" "${tmp}/SOURCE_COMMIT"); then
        rm -rf "$tmp"
        fail "Release asset verification FAILED for ${ref} (SHA256SUMS did not contain exactly one valid entry each for ${artifact} and SOURCE_COMMIT, the SOURCE_COMMIT bytes were malformed, or a checksum did not match). Aborting update."
    fi
    rm -rf "$tmp"
    # Require the fetched tag commit to equal the verified SOURCE_COMMIT.
    if [[ "$fetched" != "$source_commit" ]]; then
        fail "Deployed-commit mismatch for ${ref}: the tag resolves to ${fetched:0:12} but the verified SOURCE_COMMIT is ${source_commit:0:12}. The tag may have been moved after the release was built. Aborting update BEFORE any change."
    fi
    log "SOURCE_COMMIT binding verified: ${source_commit:0:12}" >&2
    printf '%s\n' "$source_commit"
    return 0
}

cmd_update_check() {
    require_install
    local ref current remote
    ref=$(env_value CENTRALPAY_UPDATE_REF); ref="${ref:-main}"
    current=$(git -C "$INSTALL_DIR" rev-parse HEAD)
    git -C "$INSTALL_DIR" fetch --tags origin "$ref" >/dev/null 2>&1 \
        || fail "Cannot fetch ${ref} from origin."
    remote=$(git -C "$INSTALL_DIR" rev-parse "FETCH_HEAD^{commit}")
    echo "configured ref:  ${ref}"
    echo "installed:       ${current}"
    echo "available:       ${remote}"
    if [[ "$current" == "$remote" ]]; then
        echo "status:          up to date"
    else
        echo "status:          update available (run: centralpay update)"
    fi
}

sync_management_wrapper() {
    # Keep the installed host command (MANAGEMENT_BIN, normally
    # /usr/local/bin/centralpay) in lockstep with the scripts/centralpay of
    # whichever application commit was just SUCCESSFULLY deployed. Callers
    # must invoke this ONLY after `compose up -d --wait` has already
    # returned success for the target commit — never on a failed/partial
    # deploy, so the installed command never advertises subcommands from a
    # version that isn't actually confirmed running.
    #
    # Without this, a newly added host subcommand (e.g. `stuck`) stays
    # unavailable after `centralpay update` until someone manually copies
    # scripts/centralpay over the installed copy: containers are rebuilt
    # from the new image, but this host-side wrapper is a plain file placed
    # by the installer and was previously never refreshed on update.
    #
    # Atomicity / self-overwrite safety: this function may be executing FROM
    # MANAGEMENT_BIN right now, as part of a plain `centralpay update` or
    # `centralpay rollback` run by an operator. `install`/`cp` themselves
    # give NO guarantee of atomic, fresh-inode replacement — they may
    # overwrite an existing destination's bytes in place, which would
    # truncate/corrupt this very script while it is still being read. So
    # `install` is used here ONLY to stage the new content, with its mode
    # already set, at a brand-new temporary path that does not yet exist —
    # never directly at MANAGEMENT_BIN. The temporary file lives in the SAME
    # directory as MANAGEMENT_BIN (same filesystem, guaranteed), and the
    # final `mv` between two paths on the same filesystem is a POSIX
    # rename(2), which is (a) atomic — the path always resolves to either
    # the old or the new inode, with no window where it is missing — and
    # (b) safe against a process that already holds the old path open: that
    # process (the bash interpreter executing THIS script, if it's the one
    # calling this function) keeps reading the OLD, now-unlinked inode until
    # it exits; only the NEXT invocation of `centralpay` observes the new
    # file. This has been verified experimentally: replacing a running
    # script this way never corrupts or truncates the in-flight process's
    # remaining output. Never replace MANAGEMENT_BIN any other way (e.g.
    # `install`/`cp` straight onto it, or `cat > "$MANAGEMENT_BIN"`), which
    # WOULD risk corrupting an in-flight run by truncating the bytes the
    # running interpreter is still reading.
    local src="${INSTALL_DIR}/scripts/centralpay"
    [[ -f "$src" ]] \
        || fail "scripts/centralpay is missing from the deployed commit; refusing to update ${MANAGEMENT_BIN}."

    local dir tmp
    dir=$(dirname -- "$MANAGEMENT_BIN")
    tmp=$(mktemp "${dir}/.centralpay.tmp.XXXXXX") \
        || fail "Cannot create a temporary file next to ${MANAGEMENT_BIN}."

    # Stage into the temp path only. On failure here, MANAGEMENT_BIN itself
    # was never touched.
    if ! install -m 0755 "$src" "$tmp"; then
        rm -f "$tmp"
        fail "Cannot stage the new management command (${MANAGEMENT_BIN} left unchanged)."
    fi

    # Atomic, same-filesystem rename: MANAGEMENT_BIN either still points at
    # the old inode or now points at the new one, never neither.
    if ! mv -fT -- "$tmp" "$MANAGEMENT_BIN"; then
        rm -f "$tmp"
        fail "Cannot replace ${MANAGEMENT_BIN} with the staged management command (left unchanged)."
    fi

    log "Installed management command synced: ${MANAGEMENT_BIN} ($(git -C "$INSTALL_DIR" rev-parse --short HEAD))"
}

cmd_update() {
    require_root update
    require_install
    acquire_deploy_lock
    perform_update
}

perform_update() {
    # Split out of cmd_update so the state-mutating steps (resolve commit,
    # backup, checkout, version history, build/restart, wrapper sync) are
    # reachable in tests without requiring the calling process to run as
    # root — require_root, require_install, and the deploy lock are the
    # only parts left in cmd_update itself.
    local ref previous target_commit
    ref=$(env_value CENTRALPAY_UPDATE_REF)
    ref="${ref:-main}"
    previous=$(git -C "$INSTALL_DIR" rev-parse HEAD)
    # Resolve the exact commit to deploy, binding it to a verified
    # SOURCE_COMMIT release asset for release tags. Any verification failure
    # aborts HERE — before the backup, checkout, build, migration, restart,
    # or version-history mutation below.
    target_commit=$(resolve_verified_update_commit "$ref") || exit 1
    log "Creating pre-update backup..."
    "${INSTALL_DIR}/scripts/backup.sh" || fail "Pre-update backup failed; update aborted."
    log "Deploying verified commit ${target_commit:0:12} (ref ${ref})..."
    git -C "$INSTALL_DIR" checkout -q "$target_commit"
    # Pass the captured pre-update commit explicitly so the FIRST update (no
    # version_history file yet) still records a rollback target.
    record_version_history "$(git -C "$INSTALL_DIR" rev-parse HEAD)" "$previous"

    # Bring the installed Caddyfile's mandatory security directives in line
    # with the commit just checked out, BEFORE building/restarting anything
    # else. `render-caddy-config.sh` never touches a working configuration
    # on failure (validates the candidate against the real caddy:2 image
    # first, backs up before replacing) -- so a Caddy-config problem aborts
    # the update here, before build/migrate/restart, exactly like a failed
    # commit-verification above. See that script's header for the full
    # ownership/activation model and exit-code contract (0 unchanged / 2
    # changed, restart required / 1 fatal).
    log "Syncing mandatory Caddy security configuration..."
    local caddy_sync_rc=0
    bash "${INSTALL_DIR}/scripts/render-caddy-config.sh" || caddy_sync_rc=$?
    if [[ "$caddy_sync_rc" -ne 0 && "$caddy_sync_rc" -ne 2 ]]; then
        fail "Managed Caddy configuration could not be safely synced; update aborted before any build/migration/restart. Existing services and configuration are unchanged. Roll the checked-out source back with: centralpay rollback"
    fi

    if [[ "$caddy_sync_rc" -eq 2 ]]; then
        # Activate the already-validated, already-written Caddy config HERE,
        # independent of whether the app build/migrate/restart below
        # succeeds. This candidate was already validated against the real
        # caddy:2 image and backed up before being written to disk, above --
        # its safety does not depend on api/worker building or passing
        # health checks, so gating its activation on that (as a previous
        # version of this function did) left a real gap: a build or health-
        # check failure after this point would leave the more-secure config
        # written to disk but never activated, and the advertised recovery
        # (`centralpay rollback`) never touches Caddy at all (deliberately --
        # see SECURITY.md's Caddy-rollback ratchet) and so could never have
        # closed that gap either. Caddy's admin API is intentionally disabled
        # (no hot reload possible -- see render-caddy-config.sh); only a
        # container restart activates the refreshed bind-mounted file.
        # Skipped entirely when the config did not change, so a routine
        # update never bounces Caddy for no reason.
        log "Restarting Caddy to activate the refreshed configuration..."
        compose restart caddy
        # Durably records that Caddy has actually been restarted with this
        # exact content -- without this, a crash/interrupt right here would
        # leave a future run seeing unchanged file content and wrongly
        # reporting "already up to date" while Caddy is still serving the
        # OLD configuration.
        bash "${INSTALL_DIR}/scripts/render-caddy-config.sh" --confirm-active \
            || fail "Caddy restarted, but recording activation failed; rerun 'centralpay update' to retry."
    fi

    log "Building images..."
    # Must actually change on every build: the Dockerfile's apt security-
    # refresh layer (see its `base` stage) is keyed on this, and Docker's
    # local build cache would otherwise reuse it forever after the first
    # image built on this host, silently defeating the OS package refresh
    # on every future update. Passed directly via --build-arg rather than
    # relying on docker-compose.yml's own `args:` passthrough, with
    # second-granularity so running `update` more than once in a day
    # still gets a fresh refresh. `update` always builds the just-checked-
    # out target_commit (resolved above from the live ref, never an
    # arbitrary historical one), whose Dockerfile always references this
    # ARG -- unlike a rollback target, which can predate the ARG
    # entirely; see perform_rollback below, which needs --no-cache
    # instead for exactly that reason.
    local apt_cachebust
    apt_cachebust=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    compose build --quiet --build-arg "APT_REFRESH_CACHEBUST=${apt_cachebust}"
    log "Applying migrations and restarting services (configuration in ${CONFIG_DIR} is preserved)..."
    if compose up -d --wait; then
        # Only now is the new commit confirmed running: safe to make its
        # scripts/centralpay the installed command.
        sync_management_wrapper
        log "Update complete: $(git -C "$INSTALL_DIR" rev-parse --short HEAD) (was ${previous:0:7})"
        cmd_status || true
    else
        warn "Health checks FAILED after update."
        warn "Application rollback: centralpay rollback"
        warn "Database schema is NOT downgraded automatically (migrations are"
        warn "forward-only; see MIGRATION_GUIDE.md). If the schema changed,"
        warn "restore the pre-update backup: centralpay backups && centralpay restore FILE"
        warn "The installed 'centralpay' command was left unchanged (still the"
        warn "previously working version) because this deploy did not succeed."
        exit 1
    fi
}

perform_rollback() {
    # $1 = commit to roll application files back to. Split out of
    # cmd_rollback so the state-mutating steps (pre-rollback backup,
    # checkout, version history, wrapper sync, rebuild/restart) are
    # reachable in tests without a controlling terminal — the interactive
    # "Type ROLLBACK to continue" confirmation is the only part left in
    # cmd_rollback itself.
    local previous="$1"
    log "Creating pre-rollback backup..."
    "${INSTALL_DIR}/scripts/backup.sh" || fail "Pre-rollback backup failed; aborted."
    git -C "$INSTALL_DIR" checkout -q "$previous" \
        || fail "Cannot check out ${previous}."
    record_version_history "$previous"
    # --no-cache here, not the --build-arg cache-bust used by
    # perform_update above: the checkout above may have replaced the
    # Dockerfile with a commit that predates the apt security-refresh ARG
    # entirely, and Docker only busts a layer's cache on an ARG that
    # layer actually *references* -- a --build-arg value for an ARG the
    # Dockerfile never declares/uses is silently ignored for caching
    # purposes (harmless for build success, but achieves nothing towards
    # freshness; see test_dockerfile_apt_refresh_layer_busts_the_gha_
    # build_cache's own finding that an unreferenced ARG doesn't change a
    # cache key). --no-cache sidesteps needing to know what the rollback
    # target's Dockerfile does or doesn't reference: every layer rebuilds
    # unconditionally. Rollback is rare and safety-critical, so the extra
    # build time is the right trade for guaranteed freshness regardless
    # of how old the target commit is.
    compose build --quiet --no-cache
    if compose up -d --wait; then
        # The rolled-back commit is now confirmed running: the installed
        # command must match IT, not whatever was deployed before the
        # rollback (which may be a newer, or a failed, version).
        sync_management_wrapper
        log "Rollback complete: now at ${previous:0:12}."
    else
        warn "Health checks failed after rollback; inspect: centralpay diagnose"
        warn "The installed 'centralpay' command was left unchanged because this"
        warn "rollback did not succeed."
        exit 1
    fi
}

cmd_rollback() {
    require_root rollback
    require_install
    acquire_deploy_lock
    local previous
    previous=$(grep -E '^previous=' "$VERSION_HISTORY_FILE" 2>/dev/null | cut -d= -f2- || true)
    [[ -n "$previous" ]] || fail "No previous version recorded in ${VERSION_HISTORY_FILE}."
    echo "This rolls back APPLICATION FILES to ${previous:0:12}."
    echo "The database schema is never downgraded automatically (forward-only"
    echo "migrations); if the newer schema is incompatible, restore a backup."
    local answer
    read -r -p "Type ROLLBACK to continue: " answer < /dev/tty
    [[ "$answer" == "ROLLBACK" ]] || fail "Rollback cancelled."
    perform_rollback "$previous"
}

cmd_review() {
    require_root review
    require_install
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        list|show)
            compose exec -T api python -m app.ops review "$sub" "$@"
            ;;
        acknowledge)
            compose exec -T api python -m app.ops review acknowledge "$@"
            ;;
        resolve)
            echo "Resolving marks the payment's operational review complete."
            echo "It never changes amounts, verification facts, or customer balances."
            local answer
            read -r -p "Type RESOLVE to continue: " answer < /dev/tty
            [[ "$answer" == "RESOLVE" ]] || fail "Cancelled."
            compose exec -T api python -m app.ops review resolve "$@"
            ;;
        resend)
            compose exec -T api python -m app.ops review resend "$@"
            ;;
        *)
            fail "Unknown review subcommand: ${sub} (list|show|acknowledge|resolve|resend)"
            ;;
    esac
}

cmd_notification() {
    require_root notification
    require_install
    local sub="${1:-}"
    shift || true
    case "$sub" in
        accept)
            # No separate shell-level prompt: python -m app.ops notification
            # accept already refuses (printing the full explanation) unless
            # --yes is present, exactly like `review resend`'s
            # --confirm-idempotent-bot/--yes gate.
            compose exec -T api python -m app.ops notification accept "$@"
            ;;
        *)
            fail "Unknown notification subcommand: ${sub} (accept)"
            ;;
    esac
}

cmd_backup() {
    require_root backup
    require_install
    "${INSTALL_DIR}/scripts/backup.sh"
}

cmd_backups() {
    echo "Backups in ${BACKUP_DIR}:"
    local file
    local found=false
    for file in "${BACKUP_DIR}"/*.dump; do
        [[ -e "$file" ]] || continue
        found=true
        local state="UNVALIDATED"
        if [[ -f "${file}.ok" && -f "${file}.manifest" ]]; then
            state="OK"
        elif [[ -f "${file}.ok" ]]; then
            # Validated at creation but has no checksum manifest: restoring
            # it requires the explicit RESTORE-LEGACY confirmation.
            state="OK-legacy"
        fi
        printf '  %s  %8s  %-9s  %s\n' \
            "$(date -u -r "$file" +%Y-%m-%dT%H:%M:%SZ)" \
            "$(du -h -- "$file" | cut -f1)" \
            "$state" \
            "$file"
    done
    [[ "$found" == "true" ]] || echo "  (none)"
}

restore_failure_instructions() {
    # Printed whenever the database may be partially restored. Services are
    # deliberately left STOPPED — never restart against a half-restored
    # database.
    local file="$1" latest
    latest=$(find "$BACKUP_DIR" -maxdepth 1 -name 'centralpay-*.dump' -type f \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- || true)
    {
        echo
        echo "restore_failed: the database may be PARTIALLY restored."
        echo "API, worker, and admin bot remain STOPPED on purpose."
        echo
        echo "Recovery steps:"
        echo "  1. The pre-restore backup taken moments ago is the newest file in"
        echo "     ${BACKUP_DIR}:"
        echo "       ${latest:-<none found>}"
        echo "  2. Restore it to return to the pre-restore state:"
        echo "       centralpay restore ${latest:-<pre-restore-backup>}"
        echo "  3. Only after a restore completes successfully will services be"
        echo "     started again. Do NOT run 'centralpay start' before that."
        echo "  4. The input file that failed was preserved: ${file}"
    } >&2
}

cmd_restore() {
    require_root restore
    require_install
    local file="${1:-}" confirm="${2:-}"
    [[ -n "$file" ]] || fail "Usage: centralpay restore FILE [--yes]"
    # Regular files only: symlinks are refused (symlink-swap protection).
    [[ -f "$file" && ! -L "$file" ]] \
        || fail "Backup must be an existing regular file (symlinks are refused): ${file}"
    [[ -s "$file" ]] || fail "Backup file is empty: ${file}"
    [[ "$(head -c 5 -- "$file")" == "PGDMP" ]] \
        || fail "Not a pg_dump custom-format archive (bad magic): ${file}"

    # Exclusive lock shared with scripts/backup.sh: no concurrent backup,
    # no concurrent restore. Held for the whole restore; the pre-restore
    # backup inherits it via CENTRALPAY_BACKUP_LOCK_HELD.
    mkdir -p "$BACKUP_DIR"
    exec 9>"${BACKUP_DIR}/.backup.lock"
    flock -n 9 || fail "Another backup or restore is already running."

    log "restore_validation_started: ${file}"
    compose exec -T db pg_restore --list < "$file" > /dev/null \
        || fail "restore_validation_failed: not a valid pg_dump custom-format backup."

    local manifest="${file}.manifest"
    if [[ -f "$manifest" && ! -L "$manifest" ]]; then
        local expected actual
        expected=$(grep -E '^sha256=' -- "$manifest" | head -1 | cut -d= -f2)
        [[ -n "$expected" ]] || fail "Manifest has no sha256 entry: ${manifest}"
        actual=$(sha256sum -- "$file" | cut -d' ' -f1)
        [[ "$actual" == "$expected" ]] \
            || fail "restore_validation_failed: sha256 mismatch — the backup is corrupted or was tampered with."
        log "Checksum verified (sha256 ${actual:0:12}...)."
    else
        # Legacy file with no integrity proof. --yes bypasses only the
        # interactive confirmation, never this validation gap.
        warn "No manifest/checksum found: LEGACY backup with no integrity proof."
        [[ "$confirm" != "--yes" ]] \
            || fail "--yes cannot accept a legacy backup. Run interactively and type RESTORE-LEGACY."
        local legacy
        read -r -p "Type RESTORE-LEGACY to accept the unverified file: " legacy < /dev/tty
        [[ "$legacy" == "RESTORE-LEGACY" ]] || fail "Restore cancelled."
    fi

    if [[ "$confirm" != "--yes" ]]; then
        echo "This will REPLACE the current database with: ${file}"
        echo "A pre-restore backup will be created first."
        local answer
        read -r -p "Type RESTORE to continue: " answer < /dev/tty
        [[ "$answer" == "RESTORE" ]] || fail "Restore cancelled."
    fi

    log "pre_restore_backup_started"
    CENTRALPAY_BACKUP_LOCK_HELD=1 "${INSTALL_DIR}/scripts/backup.sh" \
        || fail "Pre-restore backup failed; restore aborted (database untouched)."
    log "pre_restore_backup_completed"

    log "Stopping API, worker, admin bot, and monitor..."
    compose stop api worker
    if grep -qE '^ADMIN_BOT_ENABLED=true$' "$ENV_FILE" 2>/dev/null; then
        compose stop admin-bot
    fi
    if grep -qE '^MONITOR_ENABLED=true$' "$ENV_FILE" 2>/dev/null; then
        # Otherwise a live monitor keeps polling through the drop/restore
        # window (every MONITOR_INTERVAL_SECONDS, reconnecting each pass)
        # and can insert incident/alert/audit rows while pg_restore is
        # still loading the dump, corrupting the just-restored dataset or
        # colliding with restored primary keys. It comes back up with
        # everything else below.
        compose stop monitor
    fi

    log "restore_started: ${file}"
    compose exec -T db psql -U centralpay -d postgres -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='centralpay' AND pid <> pg_backend_pid();" >/dev/null
    compose exec -T db psql -U centralpay -d postgres -c "DROP DATABASE IF EXISTS centralpay;" >/dev/null
    compose exec -T db psql -U centralpay -d postgres -c "CREATE DATABASE centralpay OWNER centralpay;" >/dev/null
    if ! compose exec -T db pg_restore -U centralpay -d centralpay --no-owner \
        --role=centralpay --exit-on-error < "$file"; then
        restore_failure_instructions "$file"
        exit 1
    fi

    log "Running migrations..."
    if ! compose run --rm migrate alembic upgrade head; then
        restore_failure_instructions "$file"
        exit 1
    fi

    log "Verifying database integrity (db-check + sequence repair)..."
    if ! compose run --rm migrate python -m app.ops db-check --repair-sequences; then
        printf '[centralpay] ERROR: post_restore_integrity_failed\n' >&2
        restore_failure_instructions "$file"
        exit 1
    fi

    log "Restarting services..."
    compose up -d --wait || fail "Services failed health checks after restore."
    logger -t centralpay "database restore completed from ${file}" 2>/dev/null || true
    log "restore_completed: ${file} (the supplied backup file was preserved)"
}

cmd_db_check() {
    require_install
    # Read-only integrity checks (constraints, orphans, statuses, claim
    # anomalies, fee snapshots, sequence positions). --repair-sequences
    # additionally advances any sequence that fell behind its table maximum.
    # --details adds a bounded, read-only drill-down into the rows behind any
    # failed check (no writes, no network calls); it refuses to combine with
    # --repair-sequences.
    compose run --rm migrate python -m app.ops db-check "$@"
}

cmd_fee() {
    require_install
    local sub="${1:-status}"
    shift || true
    case "$sub" in
        status|history)
            compose run --rm migrate python -m app.ops fee "$sub"
            ;;
        set|schedule|cancel)
            # Mutations are root-only, delegated to the typed Python
            # operations command (no shell-generated SQL, no env-file
            # mutation). All arguments pass through verbatim as an argv
            # array — never interpolated into a shell string.
            require_root "fee ${sub}"
            compose run --rm migrate python -m app.ops fee "$sub" "$@"
            ;;
        *)
            fail "Unknown fee subcommand: ${sub} (use status|set|schedule|history|cancel)"
            ;;
    esac
}

cmd_diagnose() {
    require_install
    local domain
    domain=$(payment_domain)
    echo "CentralPay Bridge diagnostics (no secrets are printed)"
    echo "======================================================"
    # shellcheck disable=SC1091
    echo "OS:            $(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-unknown}")"
    echo "Architecture:  $(uname -m)"
    echo "Memory:        $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
    echo "Disk:          $(df -h / | awk 'NR==2 {print $4 " free of " $2}')"
    echo "Docker:        $(docker --version 2>/dev/null || echo unavailable)"
    echo "Compose:       $(docker compose version --short 2>/dev/null || echo unavailable)"
    echo
    echo "-- Containers --"
    compose ps 2>/dev/null || echo "unavailable"
    echo
    echo "-- Database --"
    echo "readiness:     $(compose exec -T db pg_isready -U centralpay -d centralpay 2>/dev/null || echo 'NOT READY')"
    echo "migration:     $(psql_count "SELECT version_num FROM alembic_version")"
    echo "pending queue: $(psql_count "SELECT count(*) FROM payments WHERE status='bot_notify_pending'")"
    # Unresolved only -- see the matching comment in cmd_status above.
    echo "unresolved manual reviews: $(psql_count "SELECT count(*) FROM payments WHERE status='manual_review' AND review_resolved_at IS NULL")"
    echo
    echo "-- Caddy configuration --"
    caddy_activation_status_line diagnose
    echo
    echo "-- API --"
    echo "local ready:   $(compose exec -T api curl -fsS --max-time 5 http://127.0.0.1:8000/health/ready 2>/dev/null || echo 'NOT READY')"
    if [[ -n "$domain" ]]; then
        echo "public ready:  HTTP $(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' "https://${domain}/health/ready" 2>/dev/null || echo 000)"
        echo
        echo "-- Network --"
        echo "DNS:           ${domain} -> $(getent ahostsv4 "$domain" 2>/dev/null | awk 'NR==1 {print $1}' || echo 'does not resolve')"
        echo "port 80:       $(ss -ltnH 'sport = :80' | head -1 | awk '{print $4}' || echo 'not listening')"
        echo "port 443:      $(ss -ltnH 'sport = :443' | head -1 | awk '{print $4}' || echo 'not listening')"
        echo "TLS cert:      $(echo | openssl s_client -servername "$domain" -connect "${domain}:443" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null || echo 'no certificate')"
        echo "CentralPay:    $(curl -sS --max-time 10 -o /dev/null -w 'HTTP %{http_code}' https://centralapi.org 2>/dev/null || echo unreachable)"
        local bot_url bot_host
        bot_url=$(env_value BOT_PAYMENT_NOTIFY_URL)
        if [[ -n "$bot_url" ]]; then
            bot_host=$(echo "$bot_url" | sed -E 's#^https?://([^/:]+).*#\1#')
            echo "Bot API host:  ${bot_host} -> $(curl -sS --max-time 10 -o /dev/null -w 'HTTP %{http_code}' "https://${bot_host}" 2>/dev/null || echo unreachable)"
        fi
    fi
    echo
    echo "-- Backups --"
    cmd_backups
    echo
    echo "-- Recent errors (last 200 lines) --"
    compose logs --tail 200 2>&1 \
        | grep -Ei '"level": ?"(error|critical)"' \
        | tail -20 || echo "none"
}

cmd_ssl() {
    require_root ssl
    require_install
    local domain
    domain=$(payment_domain)
    [[ -n "$domain" ]] || fail "Cannot determine the payment domain from configuration."
    log "Checking DNS for ${domain}..."
    local server_ip domain_ip
    server_ip=$(curl -fsS --max-time 10 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]' || true)
    domain_ip=$(getent ahostsv4 "$domain" 2>/dev/null | awk 'NR==1 {print $1}' || true)
    if [[ -z "$domain_ip" ]]; then
        fail "DNS for ${domain} does not resolve yet. Point it to ${server_ip:-this server} and retry."
    fi
    if [[ -n "$server_ip" && "$domain_ip" != "$server_ip" ]]; then
        warn "DNS resolves to ${domain_ip} but this server appears to be ${server_ip}. Certificates may fail."
    fi
    log "Restarting Caddy to retry certificate issuance..."
    compose restart caddy
    sleep 5
    local code
    code=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' "https://${domain}/health/live" 2>/dev/null || echo "000")
    if [[ "$code" == "200" ]]; then
        log "HTTPS is active: https://${domain}/health/live"
    else
        warn "HTTPS not confirmed yet (HTTP ${code}). Certificate issuance can take a minute; check: centralpay logs caddy"
    fi
}

cmd_app_cli() {
    require_install
    compose exec -T api python -m app.cli "$@"
}

cmd_reconciliation() {
    require_install
    local sub="${1:-status}"
    shift || true
    case "$sub" in
        status)
            # Reconciliation configuration lives in the WORKER process.
            # Production may recreate only the worker after a
            # RECONCILIATION_* environment change — containers only re-read
            # the env file at creation, so the api container's process
            # environment can stay stale for an arbitrary amount of time
            # after such a change (see docker-compose.yml's worker service
            # comment). Routing here to the worker container — deliberately
            # never api, and with no fallback to it — is what keeps this
            # command from silently reporting stale configuration. If the
            # worker container is not running, this fails loudly instead of
            # falling back: a down worker means reconciliation is not
            # running at all, which is itself the operationally correct
            # thing to surface, not something to paper over.
            compose exec -T worker python -m app.cli reconciliation status "$@"
            ;;
        *)
            fail "Unknown reconciliation subcommand: ${sub} (status)"
            ;;
    esac
}

cmd_reconcile_inspect() {
    require_install
    # Same reasoning as cmd_reconciliation's "status" case above: the tier
    # classification (min/fast/max ages), max attempts, the reconciliation
    # enabled flag, and the aged-out --verify confirmation gate must all
    # reflect the RUNNING RECONCILIATION WORKER's configuration, never a
    # possibly-stale api container environment after a worker-only
    # redeploy. Routing here to the worker container — deliberately never
    # api, and with no fallback to it — is what keeps `centralpay
    # reconcile` from silently reporting against stale configuration. If
    # the worker container is not running, this fails loudly instead of
    # falling back.
    compose exec -T worker python -m app.cli reconcile "$@"
}

cmd_recover_aged_out() {
    require_install
    # Identical reasoning to cmd_reconcile_inspect above: the effective
    # RECONCILIATION_MAX_AGE_SECONDS (the eligibility gate this command
    # checks) must come from the RUNNING RECONCILIATION WORKER's
    # configuration, never a possibly-stale api container environment.
    # Routing here to the worker container — deliberately never api, and
    # with no fallback to it — keeps `centralpay recover-aged-out` from
    # silently evaluating eligibility against stale configuration. If the
    # worker container is not running, this fails loudly instead of
    # falling back. Mutation (--confirm) still requires operator intent via
    # that explicit flag; this wrapper adds no separate interactive prompt.
    compose exec -T worker python -m app.cli recover-aged-out "$@"
}

cmd_credentials() {
    require_root credentials
    [[ -f "$CREDENTIALS_FILE" ]] || fail "No credentials file at ${CREDENTIALS_FILE}."
    cat "$CREDENTIALS_FILE"
}

cmd_version() {
    echo "application: $(app_version)"
    if [[ -d "${INSTALL_DIR}/.git" ]]; then
        echo "git:         $(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "compose:     $(docker compose version --short 2>/dev/null || echo unavailable)"
    echo "docker:      $(docker --version 2>/dev/null || echo unavailable)"
}

_stop_service_verified() {
    # $1 = profile name, $2 = service name (usually the same). A failed
    # `stop` (Docker daemon hiccup, timeout, ...) must not silently leave a
    # still-running, restart-enabled container while the caller persists a
    # *_ENABLED=false config -- verify the container is ACTUALLY stopped
    # (or was never running) before the caller does that, instead of
    # blindly swallowing every possible failure with `|| true`.
    local profile="$1" service="$2"
    if compose --profile "$profile" stop "$service" 2>/dev/null; then
        return 0
    fi
    local cid running
    cid=$(compose ps -q "$service" 2>/dev/null || true)
    if [[ -z "$cid" ]]; then
        return 0 # nothing running -- the stop command's failure was benign
    fi
    running=$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null || echo "unknown")
    if [[ "$running" == "true" ]]; then
        fail "Could not stop the ${service} container; it is still running. Configuration was NOT changed. Check 'docker ps'/'centralpay ${service} logs' and retry."
    fi
}

_restart_monitor_if_running() {
    # The monitor reads ADMIN_BOT_* settings (including the alert-category
    # toggles and admin_bot_enabled itself) once at container start, per
    # MONITORING.md's documented restart-on-config-change behavior. An
    # admin-bot enable/disable here must not leave an already-running
    # monitor container silently alerting (or silently not alerting) on
    # stale configuration until an operator happens to restart it by hand.
    local cid
    cid=$(compose ps -q monitor 2>/dev/null || true)
    if [[ -n "$cid" ]]; then
        compose restart monitor
        log "Monitor service restarted to pick up the admin-bot configuration change."
    fi
}

cmd_admin_bot() {
    local sub="${1:-status}"
    shift || true
    case "$sub" in
        status)
            require_install
            local enabled="disabled"
            grep -qE '^ADMIN_BOT_ENABLED=true$' "$ENV_FILE" 2>/dev/null && enabled="enabled"
            echo "configuration: ${enabled}"
            local ids
            ids=$(env_value ADMIN_TELEGRAM_IDS)
            if [[ -n "$ids" ]]; then
                echo "administrators: $(echo "$ids" | tr ',' '\n' | grep -c .) configured"
            else
                echo "administrators: none configured"
            fi
            local cid
            cid=$(compose ps -q admin-bot 2>/dev/null || true)
            if [[ -n "$cid" ]]; then
                echo "container: $(docker inspect -f '{{.State.Status}} (health: {{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}})' "$cid")"
            else
                echo "container: not running"
            fi
            ;;
        logs)
            require_install
            compose logs --tail 200 -f admin-bot
            ;;
        restart)
            require_root admin-bot restart
            require_install
            compose restart admin-bot
            ;;
        enable)
            require_root admin-bot enable
            require_install
            # Validate presence without ever printing the token value.
            [[ -n "$(env_value ADMIN_BOT_TOKEN)" ]] \
                || fail "ADMIN_BOT_TOKEN is empty in ${ENV_FILE}. Add the BotFather token first."
            local ids
            ids=$(env_value ADMIN_TELEGRAM_IDS)
            [[ "$ids" =~ ^[0-9]+(,[0-9]+)*$ ]] \
                || fail "ADMIN_TELEGRAM_IDS must be comma-separated numeric Telegram user IDs."
            sed -i 's/^ADMIN_BOT_ENABLED=.*/ADMIN_BOT_ENABLED=true/' "$ENV_FILE"
            compose up -d --wait admin-bot
            log "Admin bot enabled and started."
            _restart_monitor_if_running
            ;;
        disable)
            require_root admin-bot disable
            require_install
            # Stop the service; configuration (including the token) is
            # preserved unless the administrator edits the env file.
            _stop_service_verified admin-bot admin-bot
            sed -i 's/^ADMIN_BOT_ENABLED=.*/ADMIN_BOT_ENABLED=false/' "$ENV_FILE"
            log "Admin bot disabled. Configuration preserved in ${ENV_FILE}."
            _restart_monitor_if_running
            ;;
        test-alert)
            require_root admin-bot test-alert
            require_install
            grep -qE '^ADMIN_BOT_ENABLED=true$' "$ENV_FILE" 2>/dev/null \
                || fail "Admin bot is disabled. Enable it first: centralpay admin-bot enable"
            compose exec -T api python -m app.ops test-alert
            ;;
        *)
            fail "Unknown admin-bot subcommand: ${sub} (status|logs|restart|enable|disable|test-alert)"
            ;;
    esac
}

cmd_monitor() {
    local sub="${1:-status}"
    shift || true
    case "$sub" in
        status)
            require_install
            local enabled="disabled"
            grep -qE '^MONITOR_ENABLED=true$' "$ENV_FILE" 2>/dev/null && enabled="enabled"
            echo "configuration: ${enabled}"
            local cid
            cid=$(compose ps -q monitor 2>/dev/null || true)
            if [[ -n "$cid" ]]; then
                echo "container: $(docker inspect -f '{{.State.Status}} (health: {{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}})' "$cid")"
            else
                echo "container: not running"
            fi
            ;;
        logs)
            require_install
            compose logs --tail 200 -f monitor
            ;;
        restart)
            require_root monitor restart
            require_install
            compose restart monitor
            ;;
        enable)
            require_root monitor enable
            require_install
            if grep -qE '^MONITOR_ENABLED=' "$ENV_FILE" 2>/dev/null; then
                sed -i 's/^MONITOR_ENABLED=.*/MONITOR_ENABLED=true/' "$ENV_FILE"
            else
                printf 'MONITOR_ENABLED=true\n' >> "$ENV_FILE"
            fi
            compose up -d --wait monitor
            log "Monitor service enabled and started."
            log "Telegram delivery also requires the admin bot: centralpay admin-bot enable"
            ;;
        disable)
            require_root monitor disable
            require_install
            _stop_service_verified monitor monitor
            if grep -qE '^MONITOR_ENABLED=' "$ENV_FILE" 2>/dev/null; then
                sed -i 's/^MONITOR_ENABLED=.*/MONITOR_ENABLED=false/' "$ENV_FILE"
            else
                printf 'MONITOR_ENABLED=false\n' >> "$ENV_FILE"
            fi
            log "Monitor service disabled. Configuration preserved in ${ENV_FILE}."
            ;;
        check)
            require_install
            grep -qE '^MONITOR_ENABLED=true$' "$ENV_FILE" 2>/dev/null \
                || fail "Monitoring is disabled. Enable it first: centralpay monitor enable"
            # Routed to the monitor container specifically (never api): only
            # it has the read-only backup-directory bind mount the
            # backup/disk-space checks need, mirroring why "reconciliation
            # status"/"reconcile" are routed to the worker container above.
            compose exec -T monitor python -m app.cli monitor check "$@"
            ;;
        incidents)
            require_install
            # A pure database read with no filesystem dependency -- routed
            # through the always-running api container (never gated on
            # MONITOR_ENABLED and never requiring the monitor container to
            # be up), so incident HISTORY stays inspectable even while
            # monitoring itself is disabled/stopped (see MONITORING.md,
            # "Disabling monitoring safely").
            compose exec -T api python -m app.cli monitor incidents "$@"
            ;;
        *)
            fail "Unknown monitor subcommand: ${sub} (status|logs|restart|enable|disable|check|incidents)"
            ;;
    esac
}

cmd_uninstall() {
    require_root uninstall
    require_install
    echo "This stops and removes the CentralPay Bridge containers."
    echo "By default it PRESERVES: the PostgreSQL data volume, backups, and credentials."
    local answer
    read -r -p "Type UNINSTALL to continue: " answer < /dev/tty
    [[ "$answer" == "UNINSTALL" ]] || fail "Uninstall cancelled."

    systemctl disable --now centralpay-backup.timer 2>/dev/null || true
    rm -f /etc/systemd/system/centralpay-backup.service /etc/systemd/system/centralpay-backup.timer
    systemctl daemon-reload 2>/dev/null || true

    compose down

    read -r -p "ALSO DELETE the PostgreSQL data volume (ALL PAYMENT RECORDS)? Type DELETE-DATA to confirm, anything else to keep: " answer < /dev/tty
    if [[ "$answer" == "DELETE-DATA" ]]; then
        compose down -v
        warn "PostgreSQL data volume deleted."
    else
        log "PostgreSQL data volume preserved."
    fi

    read -r -p "ALSO DELETE backups in ${BACKUP_DIR}? Type DELETE-BACKUPS to confirm, anything else to keep: " answer < /dev/tty
    if [[ "$answer" == "DELETE-BACKUPS" ]]; then
        rm -rf "$BACKUP_DIR"
        warn "Backups deleted."
    else
        log "Backups preserved in ${BACKUP_DIR}."
    fi

    log "Configuration and credentials preserved in ${CONFIG_DIR}."
    read -r -p "Remove the 'centralpay' command itself? [y/N]: " answer < /dev/tty
    if [[ "$answer" =~ ^[Yy] ]]; then
        rm -f "$MANAGEMENT_BIN"
        log "Management command removed."
    fi
    log "Uninstall finished."
}

# ---------------------------------------------------------------------------

main() {
    local cmd="${1:-}"
    shift || true

    # Every production-mutating (or otherwise side-effecting: service
    # lifecycle, deployment, destructive) top-level command must have a
    # help path with ZERO side effects: no network fetch, git operation,
    # backup, DB migration, docker build/pull/restart, compose operation,
    # config change, file replacement, service restart, or other mutation.
    # Checked HERE, before any command-specific parsing or dispatch, so a
    # bare `-h`/`--help` anywhere in the remaining arguments always wins
    # over the real action -- this is what fixes the real incident where
    # `centralpay update --help` ran a full production update instead of
    # printing help. A handful of these commands have read-only
    # subcommands too (e.g. `fee status`, `migrate current`, `db-check`);
    # guarding the whole top-level command anyway is a harmless, strictly
    # safer default, not a behavior regression for anything that matters.
    case "$cmd" in
        update | restart | stop | start | rollback | migrate | backup | restore | \
        db-check | fee | review | notification | recover-aged-out | admin-bot | \
        monitor | ssl | uninstall)
            if wants_help "$@"; then
                usage
                exit 0
            fi
            ;;
    esac

    case "$cmd" in
        status)        cmd_status "$@" ;;
        logs)          cmd_logs "$@" ;;
        logs-errors)   cmd_logs_errors "$@" ;;
        restart)       require_root restart; require_install; compose restart ;;
        stop)          require_root stop; require_install; compose stop ;;
        start)         require_root start; require_install; compose up -d --wait ;;
        update)
            if [[ "${1:-}" == "--check" ]]; then
                cmd_update_check
            else
                cmd_update "$@"
            fi
            ;;
        rollback)      cmd_rollback "$@" ;;
        review)        cmd_review "$@" ;;
        notification)  cmd_notification "$@" ;;
        migrate)       cmd_migrate "$@" ;;
        backup)        cmd_backup "$@" ;;
        backups)       cmd_backups "$@" ;;
        restore)       cmd_restore "$@" ;;
        db-check)      cmd_db_check "$@" ;;
        fee)           cmd_fee "$@" ;;
        diagnose)      cmd_diagnose "$@" ;;
        stuck)         cmd_app_cli stuck "$@" ;;
        reconciliation) cmd_reconciliation "$@" ;;
        reconcile)     cmd_reconcile_inspect "$@" ;;
        recover-aged-out) cmd_recover_aged_out "$@" ;;
        payment)       cmd_app_cli payment "$@" ;;
        recent)        cmd_app_cli recent "$@" ;;
        retry-queue)   cmd_app_cli retry-queue "$@" ;;
        manual-review) cmd_app_cli manual-review "$@" ;;
        credentials)   cmd_credentials "$@" ;;
        admin-bot)     cmd_admin_bot "$@" ;;
        monitor)       cmd_monitor "$@" ;;
        ssl)           cmd_ssl "$@" ;;
        version)       cmd_version "$@" ;;
        uninstall)     cmd_uninstall "$@" ;;
        help|-h|--help|"") usage ;;
        *) usage; fail "Unknown command: ${cmd}" ;;
    esac
}

# Allow tests to source the functions without executing a command.
if [[ "${CENTRALPAY_CLI_SOURCE_ONLY:-0}" != "1" ]]; then
    main "$@"
fi
