# CentralPay Bridge — Caddy reverse proxy template.
# install.sh replaces {{PAYMENT_DOMAIN}} and {{TLS_EMAIL}} and writes the
# result to /etc/centralpay-bridge/Caddyfile. Automatic HTTPS is handled by
# Caddy (Let's Encrypt) using the configured email.

{
	email {{TLS_EMAIL}}
	# The admin API is not needed and must not be exposed.
	admin off
}

{{PAYMENT_DOMAIN}} {
	encode gzip

	# JSON access logs to stdout (Docker handles rotation: 20m x 5 files).
	# The sig query parameter carries the callback HMAC signature and ct
	# carries the one-time callback token; both are redacted before the log
	# line is written.
	#
	# Redacting the request URI alone is not enough: the payment-status page
	# served at /api/centralpay/callback links /static/* assets, and browsers
	# send that page's own URL -- ct and sig included -- back as the Referer
	# header on those subsequent requests (Caddy logs request headers,
	# including Referer, by default). Referrer-Policy "no-referrer" below
	# tells compliant browsers not to send it at all, but that is a
	# client-side opt-in some clients (older embedded WebViews, non-browser
	# fetchers) do not honor -- production logs have shown real ct/sig values
	# reaching Caddy's access log this way. The Referer field gets the same
	# redaction independently, as defense in depth: not "rely on
	# Referrer-Policy alone." A single global regexp catches ct= or sig=
	# wherever they occur in the referring URL's query string, in any order,
	# without touching an ordinary referrer that carries no such parameter.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace sig REDACTED
					replace ct REDACTED
				}
				request>headers>Referer regexp ([?&](?:ct|sig)=)[^&]* ${1}REDACTED
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Payment API requests are small JSON bodies; cap request size hard.
	request_body {
		max_size 64KB
	}

	# Only the public application routes are reachable. Everything else —
	# docs, internals, directory paths — returns 404. /static/* proxies ONLY
	# the application's bundled font assets (FastAPI StaticFiles: fixed
	# directory, no directory listing, no traversal).
	@public {
		path /api/custom-payment /api/centralpay/callback /health/live /health/ready /static/*
	}

	handle @public {
		reverse_proxy api:8000 {
			# Client information for the application, set by the proxy.
			header_up X-Forwarded-Proto {scheme}
			# The application trusts X-Request-ID; the proxy overwrites any
			# client-supplied value so request IDs are always proxy-issued.
			header_up X-Request-ID {http.request.uuid}
			# The application's per-IP rate limiting (app/clientip.py) trusts
			# this header because it is explicitly OVERWRITTEN here with
			# Caddy's own resolved TCP-peer address. Caddy already ignores a
			# client-supplied X-Forwarded-For by default (trusted_proxies is
			# not set below), so this line is not a spoofing fix -- it makes
			# the single-hop trust boundary explicit and auditable in this
			# repo instead of relying on Caddy's implicit default.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		respond "Not found" 404
	}
}
