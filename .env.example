# CentralPay Bridge configuration — placeholders only.
# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://centralpay:CHANGE_ME_DB_PASSWORD@localhost:5432/centralpay

# Public HTTPS base URL of this bridge, used to build the CentralPay return URL
PUBLIC_BASE_URL=https://pay.example.com

# API key the Telegram bot must send in POST /api/custom-payment (generate a long random value)
INBOUND_API_KEY=CHANGE_ME_GENERATED_INBOUND_API_KEY

# Secret used to HMAC-sign callback URLs (generate a long random value)
CALLBACK_HMAC_SECRET=CHANGE_ME_GENERATED_CALLBACK_HMAC_SECRET

# CentralPay web service. The gateway issues a SINGLE API key that
# authenticates both getLink and verify: put the same value in both
# variables (they stay separate so a future split key needs no change).
CENTRALPAY_BASE_URL=https://centralapi.org/webservice/basic
CENTRALPAY_GETLINK_API_KEY=CHANGE_ME_CENTRALPAY_API_KEY
CENTRALPAY_VERIFY_API_KEY=CHANGE_ME_CENTRALPAY_API_KEY

# LEGACY shared gateway payer id. No longer used to create new payments (each
# payment now derives a per-customer gateway userId); kept for compatibility
# and to interpret historical payments.
CENTRALPAY_USER_ID=1

# Dedicated secret for deriving a STABLE per-customer gateway payer identity
# so CentralPay saved-card suggestions can never be shared across customers
# (incident 2026-07). MUST be unique — never reuse another secret. Required for
# payment creation; empty fails closed. Generate e.g. `openssl rand -hex 32`.
CENTRALPAY_PAYER_ID_SECRET=CHANGE_ME_DEDICATED_PAYER_ID_SECRET

# Emergency privacy containment: set false to immediately stop issuing new
# payment links (callback verification of in-flight payments is unaffected).
PAYMENT_CREATION_ENABLED=true

# Timeout in seconds for outbound CentralPay HTTP calls
CENTRALPAY_TIMEOUT_SECONDS=15

# Off by default: `centralpay reconcile ORDER_ID --verify` (a diagnostic,
# read-side-only-on-OUR-side gateway check) is gated behind this flag
# because real CentralPay verify.php verify-after-verify/idempotency
# behavior has never been confirmed against production (release blocker
# B2 -- see STAGING_VALIDATION.md). Enable only after that staging
# validation procedure closes B2. `centralpay reconcile ORDER_ID` without
# --verify is unaffected -- it never contacts the gateway.
CENTRALPAY_DIAGNOSTIC_VERIFY_ENABLED=false

# json (production default) or text (development)
LOG_FORMAT=json

# Payment amount bounds in TOMAN
MIN_PAYMENT_AMOUNT_TOMAN=1000
MAX_PAYMENT_AMOUNT_TOMAN=100000000

# Optional: shown as a "return to bot" link on payer-facing pages
TELEGRAM_BOT_USERNAME=

# --- Application-level rate limiting (per API process, in-memory) ---
RATE_LIMIT_ENABLED=true
# Authenticated POST /api/custom-payment requests per minute
RATE_LIMIT_CREATE_PER_MINUTE=120
# Invalid inbound API keys tolerated per 10 minutes before 429
RATE_LIMIT_INVALID_KEY_PER_10MIN=20
# Invalid callback signatures tolerated per 10 minutes before 429
RATE_LIMIT_INVALID_SIGNATURE_PER_10MIN=100

# Emit a one-time critical admin alert + audit event when the FIRST
# gateway-verified payment is recorded (production go-live guard).
FIRST_PAYMENT_GUARD_ENABLED=false

# --- Administrator Telegram bot (optional; disabled by default) ---
ADMIN_BOT_ENABLED=false
ADMIN_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs (never usernames)
ADMIN_TELEGRAM_IDS=
ADMIN_BOT_ALERTS_ENABLED=true
ADMIN_BOT_PAYMENT_SUCCESS_ALERTS=false
ADMIN_BOT_ERROR_ALERTS=true
ADMIN_BOT_MANUAL_REVIEW_ALERTS=true
ADMIN_BOT_BACKUP_ALERTS=true
ADMIN_BOT_HEALTH_ALERTS=true
ADMIN_BOT_DAILY_REPORT_ENABLED=true
ADMIN_BOT_DAILY_REPORT_TIME=09:00
ADMIN_BOT_TIMEZONE=Asia/Tehran
ADMIN_BOT_MAX_MESSAGE_LENGTH=3500
ADMIN_BOT_ALERT_DEDUP_MINUTES=30

# --- Bot notification (Phase 2) ---

# Complete bot payment endpoint, e.g. https://bot.example.com/api/payment
BOT_PAYMENT_NOTIFY_URL=https://bot.example.com/api/payment

# Token sent in the Token header (the bot /token2 value)
BOT_NOTIFY_TOKEN=CHANGE_ME_BOT_TOKEN

# safe (default): never auto-retry ambiguous deliveries; they go to manual
# review. idempotent: ONLY when the bot developer has explicitly confirmed
# duplicate order_id delivery is idempotent.
BOT_NOTIFY_RETRY_MODE=safe

# Delivery attempt limit before manual review (reason: retry_limit_reached)
BOT_NOTIFY_MAX_ATTEMPTS=6

BOT_NOTIFY_CONNECT_TIMEOUT_SECONDS=5
BOT_NOTIFY_READ_TIMEOUT_SECONDS=15

# Worker poll interval
BOT_NOTIFY_WORKER_INTERVAL_SECONDS=10

# Claims older than this are treated as an interrupted (ambiguous) attempt.
# Must exceed connect + read timeouts.
BOT_NOTIFY_CLAIM_TIMEOUT_SECONDS=120

# --- Server-side payment reconciliation (worker) -----------------------------
# Recovers payments stuck in link_created because the payer completed payment
# but the browser callback never reached the API. Uses the SAME verification
# and settlement path as the callback (all financial checks identical); the
# callback stays the primary immediate path. Set RECONCILIATION_ENABLED=false
# to stop the polling instantly (callbacks are unaffected).
#
# Two age tiers (the stage/tier comes from the real link age, never from the
# attempt count — worker restarts cannot restart the fast window):
#   first check ~10 s after the link is issued (+ up to one scan interval);
#   ACTIVE tier, link age <  900 s (the 15-minute CentralPay link lifetime):
#     one verify every 10 s;
#   EXPIRING (slow) tier, 900 s <= link age < 7200 s (2 h): one verify every
#     300 s; every pass reserves a small slot quota for this tier so it can
#     never be starved by continuous active-tier traffic (unused capacity in
#     either tier spills to the other; the batch cap is never exceeded);
#   link age >= 7200 s: excluded from reconciliation entirely — never
#     deleted, never marked paid/failed, left in link_created for operators;
#   stop immediately once the payment is verified / leaves link_created.
RECONCILIATION_ENABLED=true
# Give the normal browser callback this long before the first server check.
RECONCILIATION_MIN_AGE_SECONDS=10
# How often the DEDICATED reconciliation thread scans for due payments.
# Reconciliation never runs inline in the notification loop, so bot
# notification delivery keeps its cadence even when a CentralPay verify call
# is slow or times out. Actual retries may lag their schedule by up to this
# scan interval.
RECONCILIATION_INTERVAL_SECONDS=5
# Payments per pass. BATCH_SIZE / INTERVAL is an AVERAGE upper bound on
# gateway verify calls — a pass may burst its whole batch back-to-back
# before waiting out the interval.
RECONCILIATION_BATCH_SIZE=10
# Per-pass slots reserved for the expiring tier (must stay below BATCH_SIZE).
RECONCILIATION_SLOW_TIER_RESERVED_SLOTS=1
# The active/expiring tier boundary and their retry cadences.
RECONCILIATION_FAST_WINDOW_SECONDS=900
RECONCILIATION_FAST_INTERVAL_SECONDS=10
RECONCILIATION_SLOW_INTERVAL_SECONDS=300
# Hard reconciliation lifetime: payments this old or older are excluded from
# selection entirely (must stay greater than FAST_WINDOW_SECONDS).
RECONCILIATION_MAX_AGE_SECONDS=7200
# Per-payment attempt budget — a SECONDARY safety guard; RECONCILIATION_MAX_AGE_SECONDS
# is the primary lifetime limit. Exhausted payments stay in link_created for
# operators — never auto-failed, never auto-paid.
RECONCILIATION_MAX_ATTEMPTS=1000
# DEPRECATED (accepted but ignored by the active schedule): the exponential
# backoff tuning of the original reconciliation release.
#RECONCILIATION_INITIAL_BACKOFF_SECONDS=20
#RECONCILIATION_MAX_BACKOFF_SECONDS=900

# --- Monitoring (app.monitor, optional) --------------------------------------
# Dedicated monitoring process/container, separate from the worker, so a dead
# worker cannot also silence detection of its own death. Disabled by default.
# Alerts are delivered through the SAME admin-bot Telegram pipeline above
# (ADMIN_BOT_ENABLED must also be true for delivery; incidents are still
# tracked in the database either way). See MONITORING.md for the full
# check/threshold reference and the incident-dedup/recovery design.
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=60
# Cadence for the one expensive check (reuses `centralpay db-check`'s SQL) --
# deliberately far less frequent than MONITOR_INTERVAL_SECONDS.
MONITOR_DB_INTEGRITY_INTERVAL_SECONDS=1800

MONITOR_WORKER_HEARTBEAT_WARNING_SECONDS=60
MONITOR_WORKER_HEARTBEAT_CRITICAL_SECONDS=180

MONITOR_NOTIFICATION_WARNING_COUNT=20
MONITOR_NOTIFICATION_CRITICAL_COUNT=100
MONITOR_NOTIFICATION_MAX_AGE_SECONDS=1800

MONITOR_MANUAL_REVIEW_WARNING_COUNT=5
MONITOR_MANUAL_REVIEW_CRITICAL_COUNT=20
MONITOR_MANUAL_REVIEW_MAX_AGE_SECONDS=21600

# Newest backup found under CENTRALPAY_BACKUP_DIR with a validated .ok sidecar.
MONITOR_BACKUP_WARNING_AGE_SECONDS=86400
MONITOR_BACKUP_CRITICAL_AGE_SECONDS=129600

# Disk usage of the filesystem backing CENTRALPAY_BACKUP_DIR (the monitor
# container's one read-only bind mount; see docker-compose.yml).
MONITOR_DISK_WARNING_PERCENT=15
MONITOR_DISK_CRITICAL_PERCENT=5
MONITOR_DISK_MIN_FREE_BYTES=1073741824

# Rolling-window bursts of genuine CentralPay transport/server failures --
# never ordinary "not paid yet" polling (see MONITORING.md).
MONITOR_GATEWAY_FAILURE_WINDOW_SECONDS=300
MONITOR_GATEWAY_FAILURE_WARNING_COUNT=3
MONITOR_GATEWAY_FAILURE_CRITICAL_COUNT=10

# Rolling-window bursts of bot-notification delivery failures, counted as
# AFFECTED PAYMENTS (never raw retry attempts).
MONITOR_BOT_FAILURE_WINDOW_SECONDS=300
MONITOR_BOT_FAILURE_WARNING_COUNT=3
MONITOR_BOT_FAILURE_CRITICAL_COUNT=10
